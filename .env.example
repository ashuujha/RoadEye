ROADEYE_DATABASE_URL=postgresql+psycopg://roadeye:roadeye@localhost:5432/roadeye
ROADEYE_DEMO_ENABLED=true
# Set a local password (16+ characters); setup generates one in ignored .env.
ROADEYE_DEMO_PASSWORD=
ROADEYE_SOURCE_MODE=synthetic
ROADEYE_EVIDENCE_ROOT=data/synthetic/evidence
ROADEYE_ACCEPT_SCORE=0.8
ROADEYE_ACCEPT_MARGIN=0.2
# Compose database password; make setup generates a unique value in .env.
ROADEYE_DB_PASSWORD=

# Optional registered recorded-video capability; requires make recorded-setup and local MP4.
ROADEYE_RECORDED_ENABLED=false
ROADEYE_RECORDED_EVIDENCE_ROOT=.runtime/evidence
ROADEYE_MODEL_ROOT=models
