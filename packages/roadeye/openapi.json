{
  "components": {
    "schemas": {
      "CameraConfig": {
        "additionalProperties": false,
        "properties": {
          "direction": {
            "const": "forward",
            "default": "forward",
            "title": "Direction",
            "type": "string"
          },
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "x": {
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "X",
            "type": "number"
          },
          "y": {
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Y",
            "type": "number"
          },
          "zone_id": {
            "pattern": "^Z[1-3]$",
            "title": "Zone Id",
            "type": "string"
          }
        },
        "required": [
          "name",
          "zone_id",
          "x",
          "y"
        ],
        "title": "CameraConfig",
        "type": "object"
      },
      "Candidate": {
        "additionalProperties": false,
        "properties": {
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "text": {
            "maxLength": 32,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "confidence"
        ],
        "title": "Candidate",
        "type": "object"
      },
      "Control": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "play",
              "pause",
              "step",
              "replay",
              "retry"
            ],
            "title": "Action",
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "title": "Control",
        "type": "object"
      },
      "Decision": {
        "additionalProperties": false,
        "properties": {
          "classification": {
            "enum": [
              "true",
              "false",
              "uncertain"
            ],
            "title": "Classification",
            "type": "string"
          },
          "notes": {
            "maxLength": 500,
            "minLength": 4,
            "title": "Notes",
            "type": "string"
          }
        },
        "required": [
          "classification",
          "notes"
        ],
        "title": "Decision",
        "type": "object"
      },
      "EdgeConfig": {
        "additionalProperties": false,
        "properties": {
          "baseline_seconds": {
            "exclusiveMinimum": 0.0,
            "maximum": 3600.0,
            "title": "Baseline Seconds",
            "type": "integer"
          },
          "distance_m": {
            "exclusiveMinimum": 0.0,
            "maximum": 100000.0,
            "title": "Distance M",
            "type": "integer"
          },
          "max_seconds": {
            "exclusiveMinimum": 0.0,
            "maximum": 7200.0,
            "title": "Max Seconds",
            "type": "integer"
          },
          "min_seconds": {
            "exclusiveMinimum": 0.0,
            "maximum": 3600.0,
            "title": "Min Seconds",
            "type": "integer"
          },
          "source": {
            "pattern": "^C[1-6]$",
            "title": "Source",
            "type": "string"
          },
          "target": {
            "pattern": "^C[1-6]$",
            "title": "Target",
            "type": "string"
          }
        },
        "required": [
          "source",
          "target",
          "distance_m",
          "min_seconds",
          "max_seconds",
          "baseline_seconds"
        ],
        "title": "EdgeConfig",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Input": {
        "additionalProperties": false,
        "properties": {
          "camera_id": {
            "pattern": "^C[1-6]$",
            "title": "Camera Id",
            "type": "string"
          },
          "captured_at": {
            "format": "date-time",
            "title": "Captured At",
            "type": "string"
          },
          "dataset_version": {
            "const": "1",
            "default": "1",
            "title": "Dataset Version",
            "type": "string"
          },
          "event_id": {
            "format": "uuid",
            "title": "Event Id",
            "type": "string"
          },
          "evidence_key": {
            "default": "plate-card.svg",
            "maxLength": 128,
            "title": "Evidence Key",
            "type": "string"
          },
          "inference_origin": {
            "const": "mock_candidates",
            "default": "mock_candidates",
            "title": "Inference Origin",
            "type": "string"
          },
          "input_confidence": {
            "default": 1,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Input Confidence",
            "type": "number"
          },
          "kind": {
            "enum": [
              "passage",
              "ocr",
              "heartbeat"
            ],
            "title": "Kind",
            "type": "string"
          },
          "lane_id": {
            "pattern": "^C[1-6]-L1$",
            "title": "Lane Id",
            "type": "string"
          },
          "passage_id": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Passage Id",
            "type": "string"
          },
          "quality": {
            "default": 1,
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Quality",
            "type": "number"
          },
          "readings": {
            "items": {
              "$ref": "#/components/schemas/Reading"
            },
            "maxItems": 16,
            "title": "Readings",
            "type": "array"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "schema_version": {
            "const": "1",
            "default": "1",
            "title": "Schema Version",
            "type": "string"
          },
          "source_mode": {
            "const": "synthetic",
            "default": "synthetic",
            "title": "Source Mode",
            "type": "string"
          }
        },
        "required": [
          "event_id",
          "run_id",
          "kind",
          "camera_id",
          "lane_id",
          "captured_at",
          "passage_id"
        ],
        "title": "Input",
        "type": "object"
      },
      "Login": {
        "additionalProperties": false,
        "properties": {
          "actor": {
            "$ref": "#/components/schemas/Role"
          },
          "password": {
            "maxLength": 256,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "actor",
          "password"
        ],
        "title": "Login",
        "type": "object"
      },
      "Reading": {
        "additionalProperties": false,
        "properties": {
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/Candidate"
            },
            "maxItems": 8,
            "title": "Candidates",
            "type": "array"
          },
          "frame_id": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Frame Id",
            "type": "string"
          }
        },
        "required": [
          "frame_id",
          "candidates"
        ],
        "title": "Reading",
        "type": "object"
      },
      "Receipt": {
        "additionalProperties": false,
        "properties": {
          "duplicate": {
            "title": "Duplicate",
            "type": "boolean"
          },
          "input_id": {
            "title": "Input Id",
            "type": "string"
          },
          "state": {
            "const": "durably_received",
            "default": "durably_received",
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "input_id",
          "duplicate"
        ],
        "title": "Receipt",
        "type": "object"
      },
      "Result": {
        "additionalProperties": false,
        "description": "Envelope for inspectable domain records; OpenAPI gives stable envelope types.",
        "properties": {
          "data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "items": {},
                "type": "array"
              }
            ],
            "title": "Data"
          }
        },
        "required": [
          "data"
        ],
        "title": "Result",
        "type": "object"
      },
      "Review": {
        "additionalProperties": false,
        "properties": {
          "plate": {
            "anyOf": [
              {
                "maxLength": 32,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plate"
          },
          "reason": {
            "maxLength": 500,
            "minLength": 4,
            "title": "Reason",
            "type": "string"
          },
          "status": {
            "enum": [
              "accepted",
              "review_required",
              "rejected"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "reason"
        ],
        "title": "Review",
        "type": "object"
      },
      "Role": {
        "enum": [
          "viewer",
          "investigator",
          "administrator",
          "approver"
        ],
        "title": "Role",
        "type": "string"
      },
      "RunCreate": {
        "additionalProperties": false,
        "properties": {
          "scenario": {
            "maxLength": 64,
            "title": "Scenario",
            "type": "string"
          }
        },
        "required": [
          "scenario"
        ],
        "title": "RunCreate",
        "type": "object"
      },
      "TrajectoryQuery": {
        "additionalProperties": false,
        "properties": {
          "end": {
            "format": "date-time",
            "title": "End",
            "type": "string"
          },
          "include_review": {
            "default": false,
            "title": "Include Review",
            "type": "boolean"
          },
          "limit": {
            "default": 100,
            "maximum": 200.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "plate": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Plate",
            "type": "string"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "start": {
            "format": "date-time",
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "start",
          "end",
          "plate"
        ],
        "title": "TrajectoryQuery",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WatchCreate": {
        "additionalProperties": false,
        "properties": {
          "plate": {
            "maxLength": 32,
            "title": "Plate",
            "type": "string"
          },
          "reason": {
            "maxLength": 500,
            "minLength": 4,
            "title": "Reason",
            "type": "string"
          },
          "run_id": {
            "format": "uuid",
            "title": "Run Id",
            "type": "string"
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Severity",
            "type": "string"
          },
          "valid_from": {
            "format": "date-time",
            "title": "Valid From",
            "type": "string"
          },
          "valid_until": {
            "format": "date-time",
            "title": "Valid Until",
            "type": "string"
          }
        },
        "required": [
          "run_id",
          "plate",
          "reason",
          "severity",
          "valid_from",
          "valid_until"
        ],
        "title": "WatchCreate",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "RoadEye synthetic engineering console",
    "version": "1.0.0"
  },
